# SQLite database file (path is relative to the prisma/ directory)
DATABASE_URL="file:./dev.db"

# Port for the combined Next.js + Socket.IO server
PORT=3000

# Session lifetime in days
SESSION_TTL_DAYS=7

# Set to "true" only when serving over HTTPS (marks the session cookie Secure)
COOKIE_SECURE=false

# Road-geometry provider for route previews and the GPS simulator.
#   local = built-in estimator only (fully offline)
#   osrm  = try the free public OSRM demo server first, fall back to local
ROUTING_PROVIDER=osrm
OSRM_URL=https://router.project-osrm.org

# Start the GPS simulator automatically with the server
SIMULATOR_AUTOSTART=true

# Demo mode: shows the "sample data" banner, one-click demo logins and the
# "Reset demo data" action, and idles the GPS simulator while nobody is watching.
# Set to false for a normal instance without any of that.
DEMO_MODE=true

# --- LogiTrack 3.0: security, operations, backups -------------------------------

# Key material for encrypting two-factor (TOTP) secrets: at least 32 random characters.
# If unset, one is generated once into prisma/app-secret.key (next to the database).
# Back it up together with your database.
# APP_SECRET=

# Sign users out after this many minutes without a request (default 720 = 12 hours).
SESSION_IDLE_MINUTES=720

# Only behind a reverse proxy you control: take the client address from X-Forwarded-For.
TRUST_PROXY=false

# Address to listen on. Use 0.0.0.0 inside containers.
# HOSTNAME_BIND=localhost

# Backups (see docs/BACKUP_RESTORE.md). Default folder: prisma/backups next to the database.
# BACKUP_DIR=
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=7

# Logging: debug | info | warn | error, and pretty | json (json is the default in production).
LOG_LEVEL=info
# LOG_FORMAT=pretty

# Origin printed in reset links created from the command line (npm run auth:reset-link).
# APP_URL=http://localhost:3000
