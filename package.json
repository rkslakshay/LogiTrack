{
  "name": "logitrack",
  "version": "3.0.0",
  "description": "Fleet and logistics management platform: vehicles, drivers, deliveries, live tracking, routes, fuel, maintenance and analytics. Runs locally at zero cost.",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "prisma generate && next build",
    "start": "cross-env NODE_ENV=production tsx server.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "setup": "node scripts/setup.mjs",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force --skip-seed && tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "vitest run && playwright test",
    "screenshots": "cross-env SHOTS=1 playwright test && node scripts/optimize-screenshots.mjs",
    "db:backup": "tsx scripts/db.ts backup",
    "db:backups": "tsx scripts/db.ts list",
    "db:verify": "tsx scripts/db.ts verify",
    "db:check": "tsx scripts/db.ts check",
    "db:restore": "tsx scripts/db.ts restore",
    "auth:reset-link": "tsx scripts/auth.ts reset-link",
    "auth:reset-mfa": "tsx scripts/auth.ts reset-mfa",
    "auth:unlock": "tsx scripts/auth.ts unlock",
    "perf:seed": "tsx scripts/perf-seed.ts",
    "perf:bench": "tsx scripts/perf-bench.ts",
    "perf:start": "cross-env NODE_ENV=production DATABASE_URL=file:./perf.db PORT=3200 LOGIN_LIMIT_PER_ADDRESS=1000 BACKUP_INTERVAL_HOURS=0 SIMULATOR_AUTOSTART=false tsx server.ts",
    "perf:profile": "tsx scripts/perf-profile.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "geist": "^1.9.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.77.0",
    "next": "16.4.6",
    "otpauth": "^9.6.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.11.0",
    "server-only": "^0.0.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "uqr": "^0.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.5",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "^31.0.1",
    "prisma": "^6.19.3",
    "tailwindcss": "4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2",
      "effect": "3.22.5"
    }
  }
}
